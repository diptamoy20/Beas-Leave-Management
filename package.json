{
  "name": "beas-leave-management",
  "version": "1.0.0",
  "description": "Beas Leave Management System",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "start": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "seed-holidays": "npm run seed --workspace=server",
    "install:all": "npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.0"
  },
  "keywords": ["leave", "management", "hr"],
  "author": "",
  "license": "ISC"
}
